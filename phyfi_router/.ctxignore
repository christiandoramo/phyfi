# ---------- Logs e temporários ----------
*.log
*.tmp
*.temp
*.swp
*.swo
*.cache
*.bak
*.old
hs_err_pid*
replay_pid*

# ---------- Sistema operacional ----------
.DS_Store
Thumbs.db
desktop.ini

