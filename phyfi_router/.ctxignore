# ============================================
# .ctxignore para projeto Android/Kotlin
# ============================================

# ---------- Versionamento / repositório ----------
.git/
.svn/
.hg/

# ---------- Builds do Gradle/Android ----------
build/
**/build/
app/build/
build/generated/
build/intermediates/
build/outputs/
.gradle/
**/.gradle/
.kotlin/
**/kotlin-build/
**/kotlin-caches/

# ---------- Configurações locais ----------
local.properties
*.properties.local

# ---------- IDEs e editores ----------
.idea/
*.iml
*.iws
*.ipr
.vscode/
.fleet/
.settings/
.classpath
.project

# ---------- Binários e artefatos compilados ----------
*.class
*.dex
# *.jar
*.aar
*.apk
*.aab
*.ap_
*.so
*.dll
*.dylib
*.exe
*.bin
*.dat
*.zip
*.tar
*.gz
*.7z
*.rar

# ---------- Imagens e mídia (opcional, remova se quiser incluir ícones) ----------
# *.png
# *.jpg
# *.jpeg
# *.gif
# *.webp
# *.svg
# *.mp3
# *.mp4
# *.wav
# *.ttf
# *.otf
# *.ico
